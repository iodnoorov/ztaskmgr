// ztaskmgr для Android: страница дня со списками, задача, её записи, настройки.
// Логика — в Rust (`src/app.rs`); здесь только экраны и то, что они показывают.

import { Button, CheckBox, LineEdit, TextEdit, ScrollView, ListView, AboutSlint, Palette } from "std-widgets.slint";

// Вкладка списка: название и сколько в нём открытых задач.
export struct ListTab {
    title: string,
    count: int,
}

// Задача на странице. state: 0 — открыта, 1 — выполнена, 2 — отменена, 3 — перенесена.
export struct TaskRow {
    text: string,
    state: int,
    // «→ 30 окт» у перенесённой.
    migrated: string,
    // «📝» или «📝 1/3» — есть записи, подзадачи.
    badge: string,
    private: bool,
}

// Пункт записей. kind: 0 — подзадача, 1 — заметка, 2 — просто текст.
export struct NoteRow {
    kind: int,
    done: bool,
    stamp: string,
    text: string,
}

// Экраны.
export enum Screen { page, task, notes, settings, about }

// Шапка экрана: «‹» назад и заголовок.
component Header inherits Rectangle {
    in property <string> title;
    in property <bool> back: true;
    callback go-back();
    height: 56px;
    background: Palette.alternate-background;
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 12px;
        spacing: 4px;
        if root.back: TouchArea {
            width: 48px;
            clicked => { root.go-back(); }
            Text {
                text: "‹";
                font-size: 32px;
                color: Palette.foreground;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
        Text {
            text: root.title;
            font-size: 20px;
            font-weight: 600;
            color: Palette.foreground;
            vertical-alignment: center;
            overflow: elide;
        }
        @children
    }
}

// Строка-действие на весь экран по ширине.
component Action inherits TouchArea {
    in property <string> text;
    in property <bool> danger;
    in property <bool> enabled-look: true;
    height: 52px;
    Rectangle {
        background: root.pressed ? Palette.alternate-background : transparent;
    }
    Text {
        x: 16px;
        text: root.text;
        font-size: 17px;
        color: root.danger ? #d32f2f : root.enabled-look ? Palette.foreground : Palette.alternate-foreground;
        vertical-alignment: center;
        height: parent.height;
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Palette.border;
    }
}

// Задача в списке: квадрат отметки и текст; зачёркнута, если закрыта.
component TaskItem inherits Rectangle {
    in property <TaskRow> task;
    in property <bool> read-only;
    callback toggle();
    callback open();
    property <bool> closed: task.state != 0;
    height: max(52px, label.preferred-height + 24px);
    TouchArea {
        clicked => { root.open(); }
    }
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 12px;
        TouchArea {
            width: 48px;
            enabled: !root.read-only && root.task.state != 3;
            clicked => { root.toggle(); }
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 4px;
                border-width: 2px;
                border-color: root.closed ? Palette.alternate-foreground : Palette.accent-background;
                background: root.task.state == 1 ? Palette.accent-background : transparent;
                Text {
                    text: root.task.state == 1 ? "✓" : root.task.state == 2 ? "✗" : root.task.state == 3 ? "›" : "";
                    color: root.task.state == 1 ? Palette.accent-foreground : Palette.alternate-foreground;
                    font-size: 15px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            label := Text {
                text: root.task.text + (root.task.migrated != "" ? "  " + root.task.migrated : "");
                font-size: 17px;
                wrap: word-wrap;
                color: root.closed ? Palette.alternate-foreground : Palette.foreground;
                // Зачёркивание: в Slint у текста его нет — линия поверх первой строки.
                Rectangle {
                    visible: root.closed;
                    x: 0;
                    y: min(parent.height, 24px) / 2;
                    width: min(parent.width, label.preferred-width);
                    height: 1px;
                    background: Palette.alternate-foreground;
                }
            }
        }
        if root.task.badge != "" || root.task.private: Text {
            text: (root.task.private ? "🔒 " : "") + root.task.badge;
            font-size: 14px;
            color: Palette.alternate-foreground;
            vertical-alignment: center;
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Palette.border;
    }
}

// Поле ввода с кнопкой: новая задача, заметка, подзадача, дата.
component InputBar inherits Rectangle {
    in property <string> placeholder;
    in property <string> button: "Добавить";
    in-out property <string> text;
    callback accepted(string);
    background: Palette.alternate-background;
    height: 64px;
    HorizontalLayout {
        padding: 8px;
        spacing: 8px;
        edit := LineEdit {
            placeholder-text: root.placeholder;
            text <=> root.text;
            accepted(t) => {
                root.accepted(t);
            }
        }
        Button {
            text: root.button;
            clicked => {
                root.accepted(edit.text);
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "ztaskmgr";
    background: Palette.background;
    preferred-width: 400px;
    preferred-height: 800px;

    in-out property <Screen> screen: Screen.page;
    in property <string> status;
    in property <string> sync-label;

    // Страница.
    in property <string> day-title;
    in property <bool> is-today;
    in property <[ListTab]> lists;
    in-out property <int> active-list;
    in property <[TaskRow]> tasks;
    in property <bool> read-only;

    // Задача.
    in property <int> task-state;
    in-out property <string> task-text;
    in property <string> task-history;
    in property <int> task-list;

    // Записи задачи.
    in property <string> notes-title;
    in property <[NoteRow]> notes;

    // Настройки.
    in-out property <string> webdav-url;
    in-out property <string> webdav-user;
    in-out property <string> webdav-password;
    in-out property <string> passphrase;
    in property <bool> encrypted;

    callback prev-day();
    callback next-day();
    callback go-today();
    callback select-list(int);
    callback toggle(int);
    callback open-task(int);
    callback add-task(string);

    callback save-text(string);
    callback set-state(int);
    callback postpone(string);
    callback move-to-list(int);
    callback shift(bool);
    callback delete-task();
    callback open-notes();

    callback add-note(string);
    callback add-subtask(string);
    callback toggle-note(int);
    callback delete-note(int);

    callback open-settings();
    callback save-settings();
    callback sync-now();
    callback change-passphrase(string);

    // Назад: «‹» в шапке.
    callback back();
    // Системная «Назад»; `popup` — открыто всплывающее окно. `false` — закрыть приложение.
    callback back-key(bool) -> bool;

    // Удаление задачи — с подтверждением.
    property <bool> confirm-delete;
    // Поле даты переноса.
    property <bool> postpone-open;
    property <string> postpone-text: "+1";
    // Выбор списка для переноса.
    property <bool> pick-list;
    // Новая фраза шифрования.
    property <string> new-passphrase;

    forward-focus: keys;
    // Экран сменился — поле ввода с фокусом пропало; без фокуса системная «Назад» не дошла бы
    // до обработчика ниже, и Slint закрыл бы приложение.
    changed screen => {
        keys.focus();
    }
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Back || event.text == Key.Escape) {
                if (root.back-key(root.confirm-delete || root.postpone-open || root.pick-list)) {
                    root.confirm-delete = false;
                    root.postpone-open = false;
                    root.pick-list = false;
                    return accept;
                }
            }
            reject
        }

        VerticalLayout {
            padding-top: root.safe-area-insets.top;
            padding-bottom: max(root.safe-area-insets.bottom, root.virtual-keyboard-size.height);
            padding-left: root.safe-area-insets.left;
            padding-right: root.safe-area-insets.right;

            // ---------------------------------------------------------- страница дня
            if root.screen == Screen.page: VerticalLayout {
                Rectangle {
                    height: 56px;
                    background: Palette.alternate-background;
                    HorizontalLayout {
                        TouchArea {
                            width: 52px;
                            clicked => { root.prev-day(); }
                            Text { text: "‹"; font-size: 40px; color: Palette.foreground; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        TouchArea {
                            clicked => { root.go-today(); }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: root.day-title;
                                    font-size: 19px;
                                    font-weight: 600;
                                    color: Palette.foreground;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: root.is-today ? "сегодня" : "к сегодня — тап";
                                    font-size: 12px;
                                    color: Palette.alternate-foreground;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                        TouchArea {
                            width: 52px;
                            clicked => { root.next-day(); }
                            Text { text: "›"; font-size: 40px; color: Palette.foreground; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        TouchArea {
                            width: 64px;
                            clicked => { root.open-settings(); }
                            VerticalLayout {
                                alignment: center;
                                Text { text: "•••"; font-size: 18px; color: Palette.foreground; horizontal-alignment: center; }
                                Text { text: root.sync-label; font-size: 11px; color: Palette.alternate-foreground; horizontal-alignment: center; }
                            }
                        }
                    }
                }

                // Вкладки списков.
                Rectangle {
                    height: 48px;
                    background: Palette.alternate-background;
                    tabs := Flickable {
                        content-width: max(self.width, tab-row.preferred-width);
                        tab-row := HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            for tab[i] in root.lists: TouchArea {
                                clicked => { root.select-list(i); }
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    Text {
                                        text: tab.title + (tab.count > 0 ? " " + tab.count : "");
                                        font-size: 16px;
                                        font-weight: i == root.active-list ? 700 : 400;
                                        color: i == root.active-list ? Palette.accent-background : Palette.foreground;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle {
                                    visible: i == root.active-list;
                                    y: parent.height - 3px;
                                    height: 3px;
                                    background: Palette.accent-background;
                                }
                            }
                        }
                    }
                }

                // Задачи списка; свайп влево-вправо — соседний день.
                SwipeGestureHandler {
                    handle-swipe-left: true;
                    handle-swipe-right: true;
                    swiped => {
                        if (self.current-position.x < self.pressed-position.x) {
                            root.next-day();
                        } else {
                            root.prev-day();
                        }
                    }
                    ListView {
                        for row[i] in root.tasks: TaskItem {
                            task: row;
                            read-only: root.read-only;
                            toggle => { root.toggle(i); }
                            open => { root.open-task(i); }
                        }
                    }
                    if root.tasks.length == 0: Text {
                        text: "В этом списке на этот день ничего нет";
                        color: Palette.alternate-foreground;
                        font-size: 15px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                if !root.read-only: new-task := InputBar {
                    placeholder: "Новая задача";
                    accepted(t) => {
                        root.add-task(t);
                        self.text = "";
                    }
                }
            }

            // ---------------------------------------------------------- задача
            if root.screen == Screen.task: VerticalLayout {
                Header {
                    title: "Задача";
                    go-back => { root.back(); }
                }
                ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding: 12px;
                        spacing: 8px;
                        TextEdit {
                            text <=> root.task-text;
                            wrap: word-wrap;
                            height: 120px;
                            enabled: !root.read-only;
                        }
                        if !root.read-only: Button {
                            text: "Сохранить текст";
                            clicked => { root.save-text(root.task-text); }
                        }
                        if root.task-history != "": Text {
                            text: root.task-history;
                            wrap: word-wrap;
                            font-size: 13px;
                            color: Palette.alternate-foreground;
                        }
                    }
                }
                if !root.read-only && root.task-state != 3: VerticalLayout {
                    Action {
                        text: root.task-state == 1 ? "Снять отметку" : "Выполнено";
                        clicked => { root.set-state(root.task-state == 1 ? 0 : 1); }
                    }
                    Action {
                        text: root.task-state == 2 ? "Вернуть в открытые" : "Отменить — делать не нужно";
                        clicked => { root.set-state(root.task-state == 2 ? 0 : 2); }
                    }
                    if root.task-state == 0: Action {
                        text: "Перенести на другой день…";
                        clicked => { root.postpone-open = true; }
                    }
                    Action {
                        text: "В другой список…";
                        clicked => { root.pick-list = true; }
                    }
                    HorizontalLayout {
                        Action {
                            text: "Выше";
                            clicked => { root.shift(true); }
                        }
                        Action {
                            text: "Ниже";
                            clicked => { root.shift(false); }
                        }
                    }
                }
                Action {
                    text: "Записи и подзадачи";
                    clicked => { root.open-notes(); }
                }
                if !root.read-only: Action {
                    text: "Удалить задачу";
                    danger: true;
                    clicked => { root.confirm-delete = true; }
                }
            }

            // ---------------------------------------------------------- записи
            if root.screen == Screen.notes: VerticalLayout {
                Header {
                    title: root.notes-title;
                    go-back => { root.back(); }
                }
                ListView {
                    for note[i] in root.notes: Rectangle {
                        height: max(52px, note-text.preferred-height + 24px);
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 4px;
                            spacing: 8px;
                            if note.kind == 0: CheckBox {
                                horizontal-stretch: 0;
                                checked: note.done;
                                toggled => { root.toggle-note(i); }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                if note.stamp != "": Text {
                                    text: note.stamp;
                                    font-size: 12px;
                                    color: Palette.alternate-foreground;
                                }
                                note-text := Text {
                                    text: note.text;
                                    wrap: word-wrap;
                                    font-size: 16px;
                                    color: note.kind == 0 && note.done ? Palette.alternate-foreground : Palette.foreground;
                                }
                            }
                            TouchArea {
                                width: 44px;
                                clicked => { root.delete-note(i); }
                                Text { text: "×"; color: Palette.alternate-foreground; font-size: 26px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
                    }
                }
                if root.notes.length == 0: Text {
                    text: "Записей пока нет";
                    color: Palette.alternate-foreground;
                    horizontal-alignment: center;
                    height: 40px;
                }
                note-input := Rectangle {
                    background: Palette.alternate-background;
                    property <string> draft;
                    height: 140px;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        note-edit := TextEdit {
                            text <=> note-input.draft;
                            wrap: word-wrap;
                            placeholder-text: "Заметка или подзадача";
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Заметка";
                                clicked => {
                                    root.add-note(note-input.draft);
                                    note-input.draft = "";
                                }
                            }
                            Button {
                                text: "Подзадача";
                                clicked => {
                                    root.add-subtask(note-input.draft);
                                    note-input.draft = "";
                                }
                            }
                        }
                    }
                }
            }

            // ---------------------------------------------------------- настройки
            if root.screen == Screen.settings: VerticalLayout {
                Header {
                    title: "Настройки";
                    go-back => { root.back(); }
                }
                ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding: 12px;
                        spacing: 6px;
                        Text { text: "Синхронизация WebDAV"; font-size: 16px; font-weight: 600; color: Palette.foreground; }
                        Text {
                            text: "Каталог книжки на сервере, например https://облако/remote.php/dav/files/ЛОГИН/ztaskmgr/. Пусто — без синхронизации.";
                            wrap: word-wrap;
                            font-size: 13px;
                            color: Palette.alternate-foreground;
                        }
                        LineEdit { placeholder-text: "Адрес"; text <=> root.webdav-url; input-type: text; }
                        LineEdit { placeholder-text: "Логин"; text <=> root.webdav-user; }
                        LineEdit { placeholder-text: "Пароль"; text <=> root.webdav-password; input-type: password; }
                        Text { text: "Шифрование"; font-size: 16px; font-weight: 600; color: Palette.foreground; }
                        Text {
                            text: "Фраза шифрует книжку на сервере; одна на всех устройствах. Пусто — без шифрования.";
                            wrap: word-wrap;
                            font-size: 13px;
                            color: Palette.alternate-foreground;
                        }
                        LineEdit { placeholder-text: "Фраза шифрования"; text <=> root.passphrase; input-type: password; }
                        Button {
                            text: "Сохранить и синхронизировать";
                            primary: true;
                            clicked => { root.save-settings(); }
                        }
                        Button {
                            text: "Синхронизировать сейчас";
                            clicked => { root.sync-now(); }
                        }
                        if root.encrypted: VerticalLayout {
                            spacing: 6px;
                            Text { text: "Сменить фразу"; font-size: 16px; font-weight: 600; color: Palette.foreground; }
                            Text {
                                text: "На сервере перешифровывается только ключ. На других устройствах потом введите новую фразу.";
                                wrap: word-wrap;
                                font-size: 13px;
                                color: Palette.alternate-foreground;
                            }
                            LineEdit { placeholder-text: "Новая фраза"; text <=> root.new-passphrase; input-type: password; }
                            Button {
                                text: "Сменить фразу";
                                clicked => {
                                    root.change-passphrase(root.new-passphrase);
                                    root.new-passphrase = "";
                                }
                            }
                        }
                        Button {
                            text: "О программе";
                            clicked => { root.screen = Screen.about; }
                        }
                    }
                }
            }

            // ---------------------------------------------------------- о программе
            if root.screen == Screen.about: VerticalLayout {
                Header {
                    title: "О программе";
                    go-back => { root.screen = Screen.settings; }
                }
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    alignment: start;
                    Text {
                        text: "ztaskmgr — записная книжка дел. Та же книжка, что в терминале, синхронизируется через WebDAV.\n\nhttps://github.com/iodnoorov/ztaskmgr";
                        wrap: word-wrap;
                        font-size: 15px;
                        color: Palette.foreground;
                    }
                    AboutSlint { }
                }
            }

            // Строка состояния.
            if root.status != "": Rectangle {
                background: Palette.alternate-background;
                height: status-text.preferred-height + 12px;
                status-text := Text {
                    x: 12px;
                    width: parent.width - 24px;
                    text: root.status;
                    wrap: word-wrap;
                    font-size: 13px;
                    color: Palette.alternate-foreground;
                }
            }
        }

        // ---------------------------------------------------------- всплывающие окна
        if root.confirm-delete || root.postpone-open || root.pick-list: Rectangle {
            background: #00000080;
            TouchArea {
                clicked => {
                    root.confirm-delete = false;
                    root.postpone-open = false;
                    root.pick-list = false;
                }
            }
            Rectangle {
                width: parent.width - 48px;
                height: dialog.preferred-height;
                background: Palette.background;
                border-radius: 8px;
                // Тап по окну не закрывает его.
                TouchArea { }
                dialog := VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    if root.confirm-delete: VerticalLayout {
                        spacing: 12px;
                        Text { text: "Удалить задачу?"; font-size: 18px; font-weight: 600; color: Palette.foreground; }
                        Text {
                            text: "Её записи не пропадут: они уйдут в DELETED_NOTES.md.";
                            wrap: word-wrap;
                            color: Palette.alternate-foreground;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Удалить";
                                primary: true;
                                clicked => {
                                    root.confirm-delete = false;
                                    root.delete-task();
                                }
                            }
                            Button {
                                text: "Отмена";
                                clicked => { root.confirm-delete = false; }
                            }
                        }
                    }
                    if root.postpone-open: VerticalLayout {
                        spacing: 10px;
                        Text { text: "Перенести на"; font-size: 18px; font-weight: 600; color: Palette.foreground; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Завтра"; clicked => { root.postpone-open = false; root.postpone("tomorrow"); } }
                            Button { text: "+2"; clicked => { root.postpone-open = false; root.postpone("+2"); } }
                            Button { text: "+7"; clicked => { root.postpone-open = false; root.postpone("+7"); } }
                        }
                        Text {
                            text: "Или дата: 30.10, 30.10.2026, +3";
                            font-size: 13px;
                            color: Palette.alternate-foreground;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit { text <=> root.postpone-text; input-type: text; }
                            Button {
                                text: "OK";
                                clicked => {
                                    root.postpone-open = false;
                                    root.postpone(root.postpone-text);
                                }
                            }
                        }
                    }
                    if root.pick-list: VerticalLayout {
                        Text { text: "В список"; font-size: 18px; font-weight: 600; color: Palette.foreground; height: 40px; }
                        for tab[i] in root.lists: Action {
                            text: tab.title;
                            enabled-look: i != root.task-list;
                            clicked => {
                                root.pick-list = false;
                                if (i != root.task-list) {
                                    root.move-to-list(i);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
